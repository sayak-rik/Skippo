{
  "expo": {
    "name": "Skippo Driver",
    "slug": "skippo-driver-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ECEDF6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Skippo needs camera access to scan student QR codes for bus enrollment.",
        "NSPhotoLibraryUsageDescription": "Skippo needs photo library access for profile pictures."
      }
    },
    "android": {
      "package": "com.skippo.driver",
      "adaptiveIcon": {
        "backgroundColor": "#ECEDF6"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Skippo needs camera access to scan student QR codes for bus enrollment."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.skippo.app"
    }
  }
}
