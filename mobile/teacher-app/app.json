{
  "expo": {
    "name": "Skippo Teacher",
    "slug": "skippo-teacher-app",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1a6b3c"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.skippo.teacher"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a6b3c"
      },
      "package": "app.skippo.teacher"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://api.skippo.app"
    },
    "plugins": []
  }
}
