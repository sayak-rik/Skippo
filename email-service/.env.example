# Skippo Email Service — environment variables
# Copy this file to .env and fill in real values.

# SMTP credentials
# For Google Workspace: use smtp.gmail.com:587 with an App Password
# For custom mail server: set your server's SMTP host/port
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@skippo.co.in
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_NAME=Skippo

# Internal API key — must match EMAIL_SERVICE_API_KEY in the backend .env
INTERNAL_API_KEY=change-me-in-production

# Set to "true" in development to log emails instead of sending
EMAIL_DRY_RUN=false
