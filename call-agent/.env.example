# ── Plivo ────────────────────────────────────────────────────────────────────
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_FROM_NUMBER=+1XXXXXXXXXX

# ── OpenAI (Whisper STT + GPT-4o-mini NLU/NLG) ───────────────────────────────
OPENAI_API_KEY=sk-...

# ── Database (same Postgres as Django backend) ────────────────────────────────
DATABASE_URL=postgresql://skippo:skippo@postgres:5432/skippo

# ── Redis (LangGraph state checkpointer, separate DB index) ──────────────────
REDIS_URL=redis://redis:6379/3

# ── Public base URL that Plivo can reach (use ngrok in local dev) ─────────────
# Example local: BASE_URL=https://abcd1234.ngrok.io
# Example prod:  BASE_URL=https://calls.skippo.app
BASE_URL=https://your-ngrok-or-domain.example.com
